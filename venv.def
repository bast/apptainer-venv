Bootstrap: docker
From: python:3.14-slim


%post
    apt-get update

    apt-get install -y --no-install-recommends git curl

    # default sh is dash
    # this is here so that source command works
    ln -sf /bin/bash /bin/sh

    curl -LsSf https://astral.sh/uv/install.sh | UV_INSTALL_DIR=/opt/uv sh

    # clean up
    apt-get clean
    rm -rf /var/lib/apt/lists/*


%environment
    export LC_ALL=C
    export LANG=C


%runscript
    export UV_LINK_MODE=copy    

    if [ ! -d "venv" ]; then
        /opt/uv/uv venv venv
        source venv/bin/activate
        /opt/uv/uv pip install -r requirements.txt
    else
        source venv/bin/activate
        if [ "requirements.txt" -nt "venv" ]; then
            echo "requirements.txt is newer than venv: updating venv"
            /opt/uv/uv pip install -r requirements.txt
            touch venv
        fi
    fi

    $@


%help
    Reads:
        requirements.txt

    Creates:
        venv

    Usage:
        $ ./venv.sif python myscript.py
        runs myscript.py inside the virtual environment defined by requirements.txt

        $ ./venv.sif python
        opens python shell inside the virtual environment defined by requirements.txt
